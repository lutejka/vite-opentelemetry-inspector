{
  "name": "vite-opentelemetry-inspector",
  "version": "0.0.2",
  "description": "OpenTelemetry traces & logs inspector as a standalone Vite DevTools devframe",
  "keywords": [
    "vite",
    "vite-plugin",
    "devtools",
    "devframe",
    "opentelemetry",
    "otel",
    "tracing",
    "observability"
  ],
  "homepage": "https://github.com/lutejka/vite-opentelemetry-inspector#readme",
  "bugs": {
    "url": "https://github.com/lutejka/vite-opentelemetry-inspector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lutejka/vite-opentelemetry-inspector.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./devtools": "./dist/devtools.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild && pnpm build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:example": "vite --config examples/vite-devtools/vite.config.ts",
    "dev": "vitest dev",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@vitejs/devtools-kit": "^0.7.6"
  },
  "devDependencies": {
    "@devframes/agentic": "1.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vueuse/core": "^15.0.0",
    "colorjs.io": "^0.7.1",
    "devframe": "1.2.6",
    "dprint": "^0.64.3",
    "eslint": "^10.0.0",
    "splitpanes": "^4.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "unbuild": "^3.6.1",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-afloat": "^0.2.0",
    "vue-tsc": "^3.0.0"
  },
  "peerDependencies": {
    "@devframes/agentic": "^1.2.0",
    "devframe": "^1.2.0",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@devframes/agentic": {
      "optional": true
    },
    "devframe": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
