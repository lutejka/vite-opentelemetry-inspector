{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "autoApprove": true,
      "platformAutomerge": true,
      "rebaseWhen": "auto",
      "automergeType": "pr"
    }
  ],
  "minimumReleaseAge": "3 days"
}
